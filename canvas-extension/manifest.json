{
  "manifest_version": 3,
  "name": "11Planner – Canvas Smart Sync",
  "version": "1.0.0",
  "description": "Extracts courses and assignments from Canvas LMS and syncs them to 11Planner.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://*.canvas.*/*",
    "https://canvas.*/*",
    "http://localhost:8000/*",
    "https://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://127.0.0.1:8000/*",
    "https://ddszcujvbvvihwsrkzsk.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}